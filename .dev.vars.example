# Settings for `npx wrangler dev` on this computer. Copy this file to .dev.vars (git ignores it).
# Never set these in production.
#
# DEV_ACCOUNT_API: the shared account service running on this computer (the cristianbagrin site's
# site/ folder, `npx wrangler dev --port 8790`). The Worker forwards /api/dev-account/* there; the
# page uses it after localStorage.setItem('tdw.dev.accountApi', '/api/dev-account/').
DEV_ACCOUNT_API=http://127.0.0.1:8790/api/
# TDW_LEGACY_SIGNUP=1 reopens old-style sign-ups, to make an old account and test the move.
# TDW_LEGACY_SIGNUP=1

# EDIT_KEY: the /edit password (production: `npx wrangler secret put EDIT_KEY`).
EDIT_KEY=choose-a-local-password
